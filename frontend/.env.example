# ==============================================================================
# LexEase Frontend Environment Variables
# ==============================================================================

# Vercel Deployment (Production):
# Set this to the public URL of your deployed LexEase backend Docker host.
# Example: https://api.yourdomain.com
# IMPORTANT: In production on Vercel, this must NEVER point to localhost.
VITE_API_BASE_URL=https://api.yourdomain.com

# Local Development (Optional):
# When running locally via `npm run dev` or Docker Compose proxy, this can be
# left empty (or set to http://localhost:8000). The frontend proxy routes /api automatically.
# VITE_API_BASE_URL=http://localhost:8000
