# ==========================================
# LexEase Environment Configuration
# ==========================================

# Active AI Provider: "groq", "openrouter", "gemini", or "cerebras"
AI_PROVIDER=groq

# Groq AI Provider Config
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT=30

# OpenRouter AI Provider Config
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_TIMEOUT=30

# Google Gemini AI Provider Config
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TEMPERATURE=0.2
GEMINI_TIMEOUT=30

# Cerebras AI Provider Config
CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama-3.3-70b
CEREBRAS_TIMEOUT=30

# General AI Settings
MAX_RETRIES=3

# Database Credentials & Configuration (Server-side secrets; never commit production passwords)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=generate_a_secure_production_password_here
POSTGRES_DB=lexease
DATABASE_URL=postgresql+psycopg2://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}

# Backend Server Config
PORT=8000
# In production, set this to your exact Vercel production domain. Keep localhost origins for local development only:
ALLOWED_ORIGINS=https://<your-project-domain>.vercel.app,http://localhost:5173
# Optional: Restricted preview origin regex for Vercel preview deployments for this project.
# Leave blank if preview deployments do not need API access. Do not use broad wildcard regexes.
# Fill in your project/team slugs: ^https://<your-project-name>(-[a-zA-Z0-9_-]+)?(-<your-team-slug>)?\.vercel\.app$
ALLOWED_ORIGIN_REGEX=

# Frontend Config
# Leave VITE_API_BASE_URL empty for local Docker testing so requests route through the proxy (http://localhost:5173).
# Set to an explicit remote URL only when deploying frontend separately (e.g. on Vercel).
VITE_API_BASE_URL=
VITE_BACKEND_URL=http://localhost:8000

# Optional Model Checkpoint Synchronization (Hugging Face Hub Fallback)
# Not required if local model checkpoint files are already present in ml/models/final_risk_model.
# If running on a host without Git LFS files, set these server-side to fetch checkpoints from Hugging Face Hub:
# LEXEASE_MODEL_REPO_ID=your-org/lexease-risk-model
# LEXEASE_MODEL_REVISION=main
# HF_TOKEN=your_huggingface_token

# Required to review consented adaptive-learning feedback. Keep this secret.
ADAPTIVE_LEARNING_ADMIN_TOKEN=replace-with-a-long-random-value
