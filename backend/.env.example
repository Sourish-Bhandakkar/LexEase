# ==============================================================================
# LexEase Backend Environment Configuration (Server-Side Only)
# ==============================================================================
# IMPORTANT: Keep this file secure. Never commit real production secrets,
# passwords, or API keys to version control.
# ==============================================================================

# Server Network & CORS Configuration
PORT=8000
# Comma-separated list of allowed web origins (your Vercel production domain; keep localhost for local development only)
ALLOWED_ORIGINS=https://<your-project-domain>.vercel.app,http://localhost:5173
# Optional restricted regex for Vercel preview deployments for this specific project.
# Leave blank if preview deployments do not need API access. Do not use broad wildcard regexes.
# Fill in your project/team slugs: ^https://<your-project-name>(-[a-zA-Z0-9_-]+)?(-<your-team-slug>)?\.vercel\.app$
ALLOWED_ORIGIN_REGEX=

# Active AI Provider: "groq", "openrouter", "gemini", or "cerebras"
AI_PROVIDER=groq

# Groq AI Provider Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT=30.0

# OpenRouter AI Provider Configuration
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openrouter/free
OPENROUTER_TIMEOUT=30.0

# Google Gemini AI Provider Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TEMPERATURE=0.2
GEMINI_TIMEOUT=30.0

# Cerebras AI Provider Configuration
CEREBRAS_API_KEY=your_cerebras_api_key_here
CEREBRAS_MODEL=llama-3.3-70b
CEREBRAS_TIMEOUT=30.0

# General AI Settings
MAX_RETRIES=3

# Database Connection (PostgreSQL with psycopg2 driver)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=generate_a_secure_production_password_here
POSTGRES_DB=lexease
# For local Docker Compose deployment, the database host is 'db' (private network):
DATABASE_URL=postgresql+psycopg2://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}
# For an external managed PostgreSQL (e.g. Supabase, AWS RDS, Neon):
# DATABASE_URL=postgresql+psycopg2://user:password@hostname:5432/dbname?sslmode=require

# Adaptive Learning Admin Review Token
# Required for reviewing user feedback, queueing candidate training, reloading models, and rollback.
# Must be a long, high-entropy secret string.
ADAPTIVE_LEARNING_ADMIN_TOKEN=generate_a_high_entropy_random_admin_secret_token_here

# Model Checkpoint Synchronization (Optional Hugging Face Hub Fallback)
# Used only if local Git LFS model checkpoint files are not present in ml/models/final_risk_model.
# LEXEASE_MODEL_REPO_ID=your-org/lexease-risk-model
# LEXEASE_MODEL_REVISION=main
# HF_TOKEN=your_huggingface_read_token_here
